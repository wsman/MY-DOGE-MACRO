# Data directory internal .gitignore
# This file manages ignore rules inside the data directory

# Keep structure files
!.gitkeep
!.gitignore
!sync.json

# Keep reports and market directories
!reports/
!market/
!alerts/

# Ignore cache directory contents (local SQLite db)
cache/*
!cache/.gitkeep

# Ignore temp files
*.tmp
*.bak
*~

# Keep actual data files for sync
!reports/**/*.md
!reports/**/index.json
!market/**/*.csv
!alerts/*.csv