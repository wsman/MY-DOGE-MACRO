# ============================================
# MY-DOGE-MICRO 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
# 不要将 .env 文件提交到 GitHub
# ============================================

# ----------------------
# DeepSeek AI API 配置
# ----------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ----------------------
# LM Studio 本地模型配置
# ----------------------
LM_STUDIO_API_KEY=lm-studio

# ----------------------
# API 认证 Token
# ----------------------
API_TOKEN=mydoge-token-dev

# ----------------------
# 服务器配置
# ----------------------
# 服务器绑定地址（默认 0.0.0.0 监听所有接口）
HOST=0.0.0.0
# 服务器端口
PORT=8765

# ----------------------
# 代理配置（如需要）
# ----------------------
# HTTP 代理地址
HTTP_PROXY=http://127.0.0.1:7890
# HTTPS 代理地址
HTTPS_PROXY=http://127.0.0.1:7890

# ----------------------
# TDX 数据路径（Windows）
# ----------------------
# TDX_PATH=D:/Games/New Tdx Vip2020
