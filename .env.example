# MY-DOGE-MACRO 环境配置模板
# 复制此文件为 .env 并填入实际值

# ===========================================
# API 配置 (必需)
# ===========================================

# DeepSeek API Key
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ===========================================
# 模型配置 (可选，覆盖 config/models_config.json)
# ===========================================

# 默认模型: deepseek-chat / deepseek-reasoner
# DEEPSEEK_MODEL=deepseek-chat

# ===========================================
# 数据源配置 (可选)
# ===========================================

# TDX 通达信 (本地数据源)
# TDX_HOST=localhost
# TDX_PORT=7700

# ===========================================
# 代理配置 (可选)
# ===========================================

# HTTP 代理 (用于访问海外 API)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ===========================================
# 应用配置 (可选)
# ===========================================

# 日志级别: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# 是否启用调试模式: true / false
# DEBUG=false

# ===========================================
# 用户认证配置 (v2.0.0+)
# ===========================================

# JWT 密钥 (生产环境请使用强密码)
JWT_SECRET=mydoge_jwt_secret_dev_key

# JWT 过期时间 (分钟)
JWT_EXPIRE_MINUTES=60

# PostgreSQL 数据库配置
POSTGRES_USER=mydoge
POSTGRES_PASSWORD=mydoge_dev_password
POSTGRES_DB=mydoge_macro

# GitHub OAuth 配置
# 获取地址: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth 回调地址 (开发环境)
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
